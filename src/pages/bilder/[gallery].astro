---
import { getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Bilder, { type GalleryPhoto } from "../../components/Bilder";
import { GALLERIES } from "../../galleries";

/**
 * Replaces the five near-identical src/pages/bilder/*.tsx files, each of which
 * carried its own `allFile` + `allCaptionJson` GraphQL query.
 */
export function getStaticPaths() {
  return GALLERIES.map((gallery) => ({
    params: { gallery: gallery.slug },
    props: { gallery },
  }));
}

/** Longest edge served to the album and lightbox. */
const MAX_WIDTH = 1200;

interface CaptionEntry {
  fileName: string;
  caption: string;
}

// import.meta.glob needs a static pattern, so the whole tree is globbed once
// and filtered per gallery below.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/stugor/*/*.jpg",
  { eager: true },
);
const allCaptions = import.meta.glob<{ default: CaptionEntry[] }>(
  "/src/images/stugor/*/caption.json",
  { eager: true },
);

const { gallery } = Astro.props;
const prefix = `/src/images/stugor/${gallery.folder}/`;

// Replaces gatsby-transformer-json + allCaptionJson. Matching is on the image
// basename, which is what caption.json actually stores.
const captionsFor: Record<string, string> = Object.fromEntries(
  (allCaptions[`${prefix}caption.json`]?.default ?? []).map((entry) => [
    entry.fileName,
    entry.caption,
  ]),
);

const photos: GalleryPhoto[] = await Promise.all(
  Object.entries(allImages)
    .filter(([path]) => path.startsWith(prefix))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, module]) => {
      const source = module.default;
      // Dimensions are derived from the source rather than read back off
      // getImage's untyped `attributes`, and drive react-photo-album's layout.
      const width = Math.min(MAX_WIDTH, source.width);
      const height = Math.round((source.height / source.width) * width);
      const optimized = await getImage({ src: source, width, format: "webp" });

      return {
        src: optimized.src,
        width,
        height,
        alt: captionsFor[path.slice(prefix.length)],
      };
    }),
);
---

<Layout
  title={`Bilder - ${gallery.name}`}
  keywords={["stugor", "bilder", "hyra scoutstuga"]}
>
  <h1><a href="/bilder/">Bilder</a> / {gallery.name}</h1>
  <Bilder photos={photos} client:load />
</Layout>
