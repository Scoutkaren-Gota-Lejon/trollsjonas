---
import { Image } from "astro:assets";
import headerImage from "../images/header.jpg";
import { SITE_TITLE, MAX_WIDTH } from "../consts";
---

<header>
  <div class="banner" style={`max-width: ${MAX_WIDTH}px`}>
    <Image src={headerImage} width={800} alt="header" loading="eager" />
    <h1><a href="/">{SITE_TITLE}</a></h1>
  </div>
</header>

<style>
  header {
    background: #0b090b;
  }

  .banner {
    margin: 0 auto;
    position: relative;
    padding: 0 1.0875rem;
    height: 100px;
  }

  .banner :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin-bottom: 0;
  }

  h1 {
    margin: 0;
    position: absolute;
    top: 30%;
  }

  h1 a {
    color: #fff;
    text-decoration: none;
  }
</style>
